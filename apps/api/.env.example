NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://dashboard:dashboard@localhost:5432/dashboard
APP_URL=http://localhost:8080
WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_DAYS=30

# Encrypts stored service credentials. Required in every environment. Generate a new one with: openssl rand -base64 32 (this one is just for testing purposes)
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Losing or changing it makes every stored credential unreadable.
MASTER_KEY=YWxyaWtpc2FtYXppbmd3b25kZXJmdWxhbmRzdXBlcmI=

# Email. Leave the block commented to print mails to the console instead of sending them.
# Once SMTP_HOST is set, SMTP_USER, SMTP_PASS and MAIL_FROM become required.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Dashboard <sender@example.com>"

# OAuth providers, used to connect services like GitHub. Leave a block commented to disable that provider:
# the API still boots and its services show as unavailable. The id and secret must be set together.
# GitHub: create an OAuth App at https://github.com/settings/developers with this callback URL
#   ${APP_URL}/api/subscriptions/oauth/github/callback   (locally: http://localhost:8080/api/subscriptions/oauth/github/callback)
# An OAuth App accepts a single callback URL, so local and production each need their own app.
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
