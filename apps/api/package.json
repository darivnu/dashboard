  {
    "name": "api",
    "private": true,
    "scripts": {
        "dev": "bun run migrate && bun --watch src/server.ts",
        "build": "bun build src/server.ts src/db/migrate.ts --target bun --outdir dist",
        "migrate": "bun src/db/migrate.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@elysiajs/openapi": "^1.4.16",
        "@elysiajs/static": "^1.3.0",
        "drizzle-orm": "^0.45.2",
        "elysia": "^1.3.0",
        "postgres": "^3.4.9"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "drizzle-kit": "^0.31.10",
        "typescript": "^5"
    }
}